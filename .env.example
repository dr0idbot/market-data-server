# Shared secret required by every client. Sent as `Authorization: Bearer <token>`.
APP_TOKEN=change-me

# OPTIONAL: enables "encrypted bearer" authentication (ENC-BEARER v1).
# Clients may then send `Authorization: Bearer enc:<payload>` where payload =
# base64( 12-byte random IV || AES-256-GCM(APP_TOKEN) ), with the AES key
# derived as SHA-256(UTF-8 of this value). Plain `Bearer <APP_TOKEN>` remains
# valid too. Unset ⇒ `enc:` bearers are rejected (plain token only).
APP_TOKEN_ENC_KEY=

# Application identity / behavior
APP_NAME=market-data-server
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# Server
HOST=0.0.0.0
PORT=8000

# Market data (yfinance) endpoint tuning
# Max tickers accepted per /v1/bulk/ohlcv call (hard ceiling 100)
BULK_MAX_SYMBOLS=25
# Max tickers per bulk call when interval is intraday (1m..1h)
BULK_INTRADAY_SYMBOLS=5
# Worker concurrency for bulk upstream fetches
YF_MAX_THREADS=4
# Max rows per page for the single-ticker OHLCV endpoint
OHLCV_PAGE_SIZE_MAX=5000
